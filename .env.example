# Copy this file to .env (in this hw4 folder) and fill in your own values.
# Never commit the real .env.

# Required: Portkey API key for the course model gateway
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional
OPENAI_MODEL=gpt-5.6-luna
PORTKEY_PROVIDER=openai
# Any long random string; keeps logins valid across backend restarts
SESSION_SECRET=replace-with-a-long-random-string
